{
    "name": "tollwerk/tw-backend-auth",
    "type": "typo3-cms-extension",
    "description": "Restrict backend authentication to given IP addresses",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "TYPO3",
        "extension",
        "authentication",
        "backend"
    ],
    "authors": [
        {
            "name": "Klaus Fiedler",
            "role": "Developer",
            "email": "klaus@tollwerk.de",
            "homepage": "https://tollwerk.de"
        }
    ],
    "homepage": "https://tollwerk.de",
    "require": {
        "typo3/cms-core": "^12.4 || ^13.4",
        "php": ">=8.3"
    },
    "autoload": {
        "psr-4": {
            "Tollwerk\\TwBackendAuth\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "tw_backend_auth"
        }
    }
}
